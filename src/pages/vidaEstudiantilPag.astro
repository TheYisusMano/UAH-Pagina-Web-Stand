---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Titulos from '../components/Titulos.astro';
---

<Layout title="Vida Estudiantil UAH">
	<Hero source="../src/img/VideoEstudiante.mp4" h2="VIDA ESTUDIANTIL" p="Descubre tu experiencia universitaria" frase="“La educación es el arma más poderosa para cambiar el mundo.”" cita="Nelson Mandela"/>
	
	<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<Titulos titulowhite="Explora Nuestra" titulored="Vida Estudiantil" clase="mb-12"/>
		
		<!-- Sección de Actividades -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
			<div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-red-900/20 hover:border-red-900/50 transition-all duration-300">
				<div class="text-center">
					<img src="../src/img/deportes.webp" alt="Deportes" class="w-20 h-20 mx-auto mb-4"/>
					<h3 class="text-2xl font-bold text-red-900 mb-2">Deportes</h3>
					<p class="text-gray-700 dark:text-gray-300">Participa en nuestros equipos deportivos y torneos internos.</p>
				</div>
			</div>
			
			<div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-red-900/20 hover:border-red-900/50 transition-all duration-300">
				<div class="text-center">
					<img src="../src/img/cultura.webp" alt="Cultura" class="w-20 h-20 mx-auto mb-4"/>
					<h3 class="text-2xl font-bold text-red-900 mb-2">Cultura</h3>
					<p class="text-gray-700 dark:text-gray-300">Explora tu lado artístico en nuestros talleres y eventos culturales.</p>
				</div>
			</div>
			
			<div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-red-900/20 hover:border-red-900/50 transition-all duration-300">
				<div class="text-center">
					<img src="../src/img/voluntariado.webp" alt="Voluntariado" class="w-20 h-20 mx-auto mb-4"/>
					<h3 class="text-2xl font-bold text-red-900 mb-2">Voluntariado</h3>
					<p class="text-gray-700 dark:text-gray-300">Únete a nuestras iniciativas de responsabilidad social.</p>
				</div>
			</div>
		</div>

		<!-- Testimonios -->
		<div class="bg-gradient-to-br from-red-900 to-red-950 rounded-lg p-8 mb-16">
			<h2 class="text-3xl font-bold text-white text-center mb-8">Testimonios de Nuestros Estudiantes</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="bg-white/10 backdrop-blur-sm rounded-lg p-6">
					<p class="text-white italic mb-4">"La UAH me ha brindado oportunidades increíbles para crecer tanto académica como personalmente."</p>
					<p class="text-red-200 font-semibold">- María González, Estudiante de Derecho</p>
				</div>
				<div class="bg-white/10 backdrop-blur-sm rounded-lg p-6">
					<p class="text-white italic mb-4">"Gracias a las actividades extracurriculares, he desarrollado habilidades que no imaginé tener."</p>
					<p class="text-red-200 font-semibold">- Carlos Martínez, Estudiante de Ingeniería</p>
				</div>
			</div>
		</div>

		<!-- Galería -->
		<div class="mb-16">
			<h2 class="text-3xl font-bold text-red-900 text-center mb-8">Galería de Eventos</h2>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<img src="../src/img/evento1.webp" alt="Evento 1" class="w-full h-48 object-cover rounded-lg"/>
				<img src="../src/img/evento2.webp" alt="Evento 2" class="w-full h-48 object-cover rounded-lg"/>
				<img src="../src/img/evento3.webp" alt="Evento 3" class="w-full h-48 object-cover rounded-lg"/>
				<img src="../src/img/evento4.webp" alt="Evento 4" class="w-full h-48 object-cover rounded-lg"/>
			</div>
		</div>
	</section>
</Layout>

<script async src="//www.instagram.com/embed.js"></script>