---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Titulos from '../components/Titulos.astro';
---
<Layout title="Pagina uah">
	<Hero source="../src/img/VideoDeporte1.mp4" h2="CLASE UAH" p="Disfruta de actividades " frase="“El verdadero disfrute proviene de la actividad mental y del ejercicio del cuerpo”" cita="Alejandro de Humboldt"/>
	<Titulos titulowhite="Actividades" titulored="Universitarias" clase="pt-32 pb-8"/>
	<div class=" text-white mb-4 text-center">
		<h4 class="text-white text-3xl lg:text-3xl pb-3 font-semibold">Actividades Recreativas</h4>
		<ul class="pt-8 pb-4 inline-flex space-x-10 text-xl border-b-2 border-opacity-80 px-4 hover:cursor-pointer">
			<li id="VoleibolEquipo" class="hover:opacity-70 border-black">Deportes Grupales</li>
			<li id="Karate"  class="hover:opacity-70 border-black">Deportes Individuales</li>
			<li id="Charla" class="hover:opacity-70 border-black">Charlas</li>
			<li id="Juego" class="hover:opacity-70 border-black">Actividades Recreativas</li>
			<li id="Orfeon" class="hover:opacity-70 border-black">Orfeón</li>
		</ul>
	</div>	
	<div class="px-10 m-auto">
		<img id="imgActividades" class="m-auto py-8 w-[600px] h-[400px] " src="../src/img/VoleibolEquipo.webp" alt="">
	</div>
	<div class="m-auto text-center pb-4 h-1/3 ">
        <h4 class="text-red-900 text-3xl lg:text-3xl pb-3 font-semibold text-center">Descripción</h4>
        <p id="descripcion" class="text-black dark:text-white text-xl lg:text-xl ">El equipo de voleibol de nuestra universidad se alzó con el campeonato en un emocionante evento celebrado en Yaracuy. ¡Orgullo universitario!</p>
    </div>
</Layout>

<script>
	let voleibolEquipoBtn = document.getElementById("VoleibolEquipo");
	let karateBtn = document.getElementById("Karate");
	let charlaBtn = document.getElementById("Charla");
	let juegoBtn = document.getElementById("Juego");
	let orfeonBtn = document.getElementById("Orfeon");
	let imgSedes = document.getElementById("imgActividades");

    voleibolEquipoBtn.onclick = function() {
        imgSedes.src = "../src/img/VoleibolEquipo.webp";
		document.getElementById('descripcion').innerHTML = 'El equipo de voleibol de nuestra universidad se alzó con el campeonato en un emocionante evento celebrado en Yaracuy. ¡Orgullo universitario!';
    }

	karateBtn.onclick = function() {
        imgSedes.src = "../src/img/Karate.webp";
		document.getElementById('descripcion').innerHTML = 'Nuestro campeón de karate demostró su destreza y disciplina en una de sus recientes competencias, dejando en alto el nombre de la universidad.';
	}

	charlaBtn.onclick = function() {
        imgSedes.src = "../src/img/Charla.webp";
		document.getElementById('descripcion').innerHTML = 'La universidad ofrece valiosas charlas y ponencias con profesionales externos, enriqueciendo el aprendizaje de nuestros estudiantes en diversas áreas.';
    }

	juegoBtn.onclick = function() {
        imgSedes.src = "../src/img/Juego.webp";
		document.getElementById('descripcion').innerHTML = 'Nuestros estudiantes disfrutan de momentos de esparcimiento y camaradería con juegos de mesa en las instalaciones de la universidad.';
	}

	orfeonBtn.onclick = function() {
        imgSedes.src = "../src/img/Orfeon.webp";
		document.getElementById('descripcion').innerHTML = 'El Orfeón de nuestra universidad deleita con su talento musical, representando el espíritu cultural de nuestra institución.';
	}
</script>