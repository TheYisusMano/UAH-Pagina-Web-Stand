---
import Titulos from '../components/Titulos.astro';
import CardComponente from './CardComponente.astro';
---
<article class="pt-8 ">
    <Titulos titulored="Extracurriculares" titulowhite="Actividades" clase="pb-10"/>
    <div id="CardComponente" class="flex justify-center p-4 md:p-0">
        <CardComponente ImgFull = "../src/img/DeporteUah2.webp" ImgIcon = "../src/img/uahDeporteIcon.webp" />
	</div>
	<div class="flex flex-col justify-center pt-4 md:pt-16">
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
			{[
				'Voleibol',
				'Futbol Campo',
				'Baloncesto',
				'Karate',
				'Natación',
				'Orfeón',
				'Radio',
				'Ajedréz',
				'Atletismo',
				'Futbol Sala'
			].map((deporte) => (
				<div class="group transform transition-all duration-300 hover:scale-105">
					<div class="bg-red-50 dark:bg-red-900/20 shadow-lg rounded-xl overflow-hidden 
								border-l-4 border-red-900 
								hover:bg-red-900 hover:text-white
								transition-all duration-300
								p-6 h-full flex items-center">
						<h2 class="text-xl font-semibold text-red-900 dark:text-red-50 
								   group-hover:text-white 
								   transition-colors duration-300 
								   text-center w-full">
							{deporte}
						</h2>
					</div>
				</div>
			))}
		</div>
	</div>
</article>

<style>
	@keyframes show {
		from{
			opacity: 0;
			scale: 25%;
		}

		to{
			opacity: 1;
			scale: 100%;
		}
	}

	#CardComponente {
		view-timeline-name: --image;
		view-timeline-axis: block;
		animation-timeline: --image;
		animation-name: show;

        animation-range: entry 15% cover 35%;
        animation-fill-mode: both;
	}
</style>