---
const { h2 } = Astro.props
const { p } = Astro.props
const { source } = Astro.props
const { frase } = Astro.props
const { cita } = Astro.props
const { clase } = Astro.props
---
<div class={`w-full h-full flex flex-col ${clase}`}>
    <section class="w-full h-[70vh] relative">
        <div class="w-full h-full bg-gradient-to-b from-transparent to-80% to-black absolute opacity-80"></div>
        <video class="h-full w-full object-cover" autoplay loop muted playsinline>
            <source src={source} type="video/mp4">
            Tu navegador no soporta el tag de video.
        </video>

        <!-- Contenido del hero -->
        <div class="absolute top-0 left-0 w-full h-full flex flex-col md:flex-row">
            <!-- Sección izquierda -->
            <div class="w-full md:w-1/2 flex flex-col justify-center items-center md:items-start p-8">
                <h1 class="text-4xl md:text-6xl font-bold text-white mb-4 animate-fade-in animate-delay-500">{h2}</h1>
                <p class="text-2xl md:text-3xl text-white animate-fade-in animate-delay-700">{p}</p>
            </div>

            <!-- Sección derecha -->
            <div class="w-full md:w-1/2 flex flex-col justify-center items-center md:items-end p-8">
                <blockquote class="text-xl md:text-2xl text-white text-right mb-4 animate-fade-in animate-delay-900">
                    "{frase}"
                </blockquote>
                <cite class="text-lg md:text-xl text-white animate-fade-in animate-delay-1000">- {cita}</cite>
            </div>
        </div>
    </section>
</div>


